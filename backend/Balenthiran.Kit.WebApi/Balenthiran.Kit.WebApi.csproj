<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The template's WebApi minus every package: no EF/Npgsql (Kit stores in git, kit#117),
       no AutoMapper, and no OpenAPI generator because Kit's UI calls a hand-written client.
       The ASP.NET Core shared framework comes with the Web SDK, so this adds no package. -->
  <PropertyGroup>
    <EnableDefaultResourceItems>false</EnableDefaultResourceItems>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Balenthiran.Kit.Services/Balenthiran.Kit.Services.csproj" />
    <ProjectReference Include="../Balenthiran.Kit.Abstractions/Balenthiran.Kit.Abstractions.csproj" />
    <ProjectReference Include="../Balenthiran.Kit.DataModels/Balenthiran.Kit.DataModels.csproj" />
    <ProjectReference Include="../Balenthiran.Kit.Database/Balenthiran.Kit.Database.csproj" />
  </ItemGroup>

</Project>
