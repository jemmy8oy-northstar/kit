<Project Sdk="Microsoft.NET.Sdk">

  <!-- Empty, and deliberately WITHOUT the template's EF Core / Npgsql references:
       Kit's storage is git (kit#117), so this layer will hold the git store when
       the write-back is built rather than a DbContext nobody uses. -->
  <ItemGroup>
    <ProjectReference Include="../Balenthiran.Kit.EntityModels/Balenthiran.Kit.EntityModels.csproj" />
    <ProjectReference Include="../Balenthiran.Kit.Abstractions/Balenthiran.Kit.Abstractions.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <EnableDefaultResourceItems>false</EnableDefaultResourceItems>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
